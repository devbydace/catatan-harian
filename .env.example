# ==============================================================================
# Daily Bot - Environment Configuration
# ==============================================================================

# 1. Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Database Neon (PostgreSQL)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-frost-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 3. Secret Token Webhook (Wajib untuk verifikasi request dari Telegram di mode webhook)
WEBHOOK_SECRET=super_secret_webhook_token_123

# 4. Port Server Webhook (default 3000)
PORT=3000

# 5. Whitelist Pengguna (Opsional - kosongkan jika bot untuk publik/siapa saja)
# Contoh: 12345678,87654321 (id Telegram angka)
ALLOWED_TELEGRAM_IDS=

# 6. Default Timezone
DEFAULT_TIMEZONE=Asia/Jakarta

# 7. Environment Mode (development / production)
NODE_ENV=development

