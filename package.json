{
  "name": "bot-tele-daily",
  "version": "1.0.0",
  "description": "Bot Telegram untuk mencatat keuangan harian, gaji, dan absen keberangkatan kerja dengan Neon PostgreSQL",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:polling": "tsx watch src/dev-polling.ts",
    "build": "tsup src/index.ts --format esm --no-dts --clean",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "webhook:set": "tsx scripts/set-webhook.ts",
    "test": "vitest run"
  },
  "keywords": [
    "telegram-bot",
    "grammy",
    "neon",
    "postgresql",
    "drizzle-orm",
    "personal-finance",
    "attendance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/conversations": "^2.1.1",
    "@grammyjs/menu": "^1.5.0",
    "@grammyjs/ratelimiter": "^1.2.1",
    "@grammyjs/runner": "^2.0.3",
    "@neondatabase/serverless": "^0.10.4",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "grammy": "^1.34.0",
    "hono": "^4.6.17",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
